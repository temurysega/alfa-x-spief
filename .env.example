# Скопируй в .env и поменяй значения. Файл .env в git не попадает.

# Пароль ведущего для входа в /admin. На сервере — длинный и случайный.
ADMIN_PASSWORD=change-me-please

# Пароль базы. Наружу база не открыта, но всё равно не оставляй этот.
DB_PASSWORD=local-db-password

# Порт, на котором открывается игра: http://localhost:8080
PORT=8080
